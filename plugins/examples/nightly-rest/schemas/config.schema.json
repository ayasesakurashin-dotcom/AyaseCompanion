{
  "type": "object",
  "required": [
    "time",
    "timeZone",
    "missedPolicy",
    "ttlSeconds",
    "response"
  ],
  "properties": {
    "time": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "title": "每天提醒时间"
    },
    "timeZone": {
      "type": "string",
      "title": "IANA 时区或 system"
    },
    "missedPolicy": {
      "enum": [
        "skip",
        "within-ttl"
      ],
      "title": "错过提醒时"
    },
    "ttlSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600,
      "default": 300,
      "title": "排队有效期（秒）"
    },
    "response": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "fixed",
            "generated",
            "generated-with-fallback"
          ],
          "title": "回复来源：fixed 固定 / generated 生成 / generated-with-fallback 生成并设后备"
        },
        "variants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "weight": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 10000
              },
              "text": {
                "title": "固定文字（支持多段）",
                "description": "每个列表条目独立分页和阅读；标点与换行保留。整组属于同一任务。",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 12000
                  },
                  {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "maxLength": 12000
                    }
                  }
                ]
              },
              "textAsset": {
                "title": "文字素材编号",
                "description": "按顺序播放，编号可用逗号或换行分隔，也可使用 JSON 数组；最多32条。",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 8192
                  },
                  {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    }
                  }
                ]
              },
              "audioAsset": {
                "title": "音声素材编号",
                "description": "按顺序播放，编号可用逗号或换行分隔，也可使用 JSON 数组；最多32条。",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 8192
                  },
                  {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    }
                  }
                ]
              },
              "cue": {
                "title": "语义动作编号",
                "description": "按顺序播放，编号可用逗号或换行分隔，也可使用 JSON 数组；最多32条。",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 8192
                  },
                  {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    }
                  }
                ]
              },
              "readMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 30000
              }
            }
          },
          "title": "固定回复变体"
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "title": "统一人格生成的互动目的"
        },
        "fallback": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "weight": {
                "type": "number",
                "minimum": 0.001,
                "maximum": 10000
              },
              "text": {
                "title": "固定文字（支持多段）",
                "description": "每个列表条目独立分页和阅读；标点与换行保留。整组属于同一任务。",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 12000
                  },
                  {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "maxLength": 12000
                    }
                  }
                ]
              },
              "textAsset": {
                "title": "文字素材编号",
                "description": "按顺序播放，编号可用逗号或换行分隔，也可使用 JSON 数组；最多32条。",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 8192
                  },
                  {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    }
                  }
                ]
              },
              "audioAsset": {
                "title": "音声素材编号",
                "description": "按顺序播放，编号可用逗号或换行分隔，也可使用 JSON 数组；最多32条。",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 8192
                  },
                  {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    }
                  }
                ]
              },
              "cue": {
                "title": "语义动作编号",
                "description": "按顺序播放，编号可用逗号或换行分隔，也可使用 JSON 数组；最多32条。",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "maxLength": 8192
                  },
                  {
                    "type": "array",
                    "maxItems": 32,
                    "items": {
                      "type": "string",
                      "maxLength": 128
                    }
                  }
                ]
              },
              "readMs": {
                "type": "integer",
                "minimum": 1000,
                "maximum": 30000
              }
            }
          },
          "title": "生成失败时明确使用的固定后备"
        },
        "cue": {
          "type": "string",
          "maxLength": 128
        },
        "voice": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "off",
                "tts"
              ]
            },
            "presentationPolicy": {
              "enum": [
                "text-first",
                "speech-synchronized"
              ]
            }
          },
          "title": "生成回复的语音策略"
        }
      }
    }
  }
}
