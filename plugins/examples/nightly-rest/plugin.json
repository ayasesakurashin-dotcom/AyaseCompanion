{
  "format": "ayase.plugin",
  "formatVersion": "1.0",
  "pluginId": "example.nightly-rest",
  "version": "0.2.0",
  "displayName": "夜间休息提醒",
  "apiVersion": "1.0",
  "configVersion": "1.0",
  "runtime": {
    "type": "declarative.v1",
    "entry": "rules/main.json"
  },
  "configSchema": "schemas/config.schema.json",
  "defaultPriority": "normal",
  "capabilities": [
    "clock.schedule",
    "presentation.request"
  ],
  "defaults": {
    "time": "23:00",
    "timeZone": "system",
    "missedPolicy": "skip",
    "ttlSeconds": 300,
    "response": {
      "mode": "fixed",
      "variants": [
        {
          "id": "rest-1",
          "weight": 1,
          "text": "已经很晚了，记得休息。",
          "cue": "reminder"
        }
      ]
    }
  }
}
