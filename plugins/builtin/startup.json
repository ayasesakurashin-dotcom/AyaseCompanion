{
  "manifest": {
    "format": "ayase.plugin",
    "formatVersion": "1.0",
    "pluginId": "ayase.startup-greeting",
    "version": "0.2.0",
    "displayName": "启动问候",
    "apiVersion": "1.0",
    "configVersion": "1.0",
    "runtime": {
      "type": "declarative.v1",
      "entry": "rules/main.json"
    },
    "configSchema": "schemas/config.schema.json",
    "defaultPriority": "normal",
    "capabilities": [
      "presentation.request"
    ],
    "defaults": {
      "source": "app.ready",
      "timeZone": "system",
      "ttlSeconds": 300,
      "windows": [
        {
          "id": "all-day",
          "start": "00:00",
          "end": "00:00",
          "allDay": true,
          "response": {
            "mode": "fixed",
            "variants": [
              {
                "id": "hello",
                "text": "你好，我在这里。",
                "cue": "greeting"
              }
            ]
          }
        }
      ],
      "dailyDedupe": false
    }
  },
  "schema": {
    "type": "object",
    "required": [
      "source",
      "timeZone",
      "ttlSeconds",
      "windows"
    ],
    "properties": {
      "source": {
        "enum": [
          "app.ready",
          "system.login",
          "system.unlock",
          "system.resume"
        ],
        "title": "事件来源"
      },
      "timeZone": {
        "type": "string",
        "title": "时区"
      },
      "ttlSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3600,
        "default": 300,
        "title": "排队有效期（秒）"
      },
      "windows": {
        "type": "array",
        "maxItems": 24,
        "items": {
          "type": "object",
          "required": [
            "id",
            "start",
            "end",
            "response"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "start": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "end": {
              "type": "string",
              "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "allDay": {
              "type": "boolean"
            },
            "response": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "type": "object",
              "required": [
                "mode"
              ],
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "fixed",
                    "generated",
                    "generated-with-fallback"
                  ],
                  "title": "回复来源：fixed 固定 / generated 生成 / generated-with-fallback 生成并设后备"
                },
                "variants": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "weight": {
                        "type": "number",
                        "minimum": 0.001,
                        "maximum": 10000
                      },
                      "text": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string",
                            "maxLength": 12000
                          }
                        ]
                      },
                      "textAsset": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      },
                      "audioAsset": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      },
                      "cue": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      },
                      "readMs": {
                        "type": "integer",
                        "minimum": 1000,
                        "maximum": 30000
                      }
                    }
                  },
                  "title": "固定回复变体"
                },
                "intent": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000,
                  "title": "统一人格生成的互动目的"
                },
                "fallback": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": {
                    "type": "object",
                    "required": [
                      "id"
                    ],
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 128
                      },
                      "weight": {
                        "type": "number",
                        "minimum": 0.001,
                        "maximum": 10000
                      },
                      "text": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string",
                            "maxLength": 12000
                          }
                        ]
                      },
                      "textAsset": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      },
                      "audioAsset": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      },
                      "cue": {
                        "anyOf": [
                          {
                            "type": "null"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      },
                      "readMs": {
                        "type": "integer",
                        "minimum": 1000,
                        "maximum": 30000
                      }
                    }
                  },
                  "title": "生成失败时明确使用的固定后备"
                },
                "cue": {
                  "type": "string",
                  "maxLength": 128
                },
                "voice": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "mode": {
                      "enum": [
                        "off",
                        "tts"
                      ]
                    },
                    "presentationPolicy": {
                      "enum": [
                        "text-first",
                        "speech-synchronized"
                      ]
                    }
                  },
                  "title": "生成回复的语音策略"
                }
              }
            }
          }
        }
      },
      "dailyDedupe": {
        "type": "boolean",
        "title": "每日只问候一次",
        "default": false
      }
    }
  },
  "rules": {
    "schemaVersion": "1.0",
    "subscriptions": [
      {
        "id": "ready",
        "type": "app.ready"
      }
    ],
    "rules": [
      {
        "id": "greet",
        "on": "ready",
        "actions": [
          {
            "type": "presentation.request",
            "responseFromConfig": "/windows",
            "ttlSecondsFromConfig": "/ttlSeconds"
          }
        ]
      }
    ]
  }
}
