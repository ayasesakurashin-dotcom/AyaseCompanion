{
  "manifest": {
    "format": "ayase.plugin",
    "formatVersion": "1.0",
    "pluginId": "ayase.work-reminder",
    "version": "0.3.0",
    "displayName": "工作与休息提醒",
    "apiVersion": "1.0",
    "configVersion": "1.0",
    "runtime": {
      "type": "declarative.v1",
      "entry": "rules/main.json"
    },
    "configSchema": "schemas/config.schema.json",
    "defaultPriority": "background",
    "capabilities": [
      "presentation.request"
    ],
    "hostBehavior": "work-reminder",
    "defaults": {
      "timeZone": "system",
      "start": "08:00",
      "end": "23:00",
      "cooldownSeconds": 2700,
      "dailyLimit": 2,
      "ttlSeconds": 180,
      "response": {
        "mode": "generated-with-fallback",
        "intent": "按当前计时口径提醒短暂休息，不声称知道用户一直在工作。",
        "fallback": [
          {
            "id": "default",
            "text": "计时已经到设定的阈值了，要不要休息一下？"
          }
        ]
      },
      "basis": "app-runtime",
      "thresholdSeconds": 3600,
      "restSeconds": 300,
      "activeWithinSeconds": 60
    }
  },
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "timeZone",
      "start",
      "end",
      "cooldownSeconds",
      "dailyLimit",
      "ttlSeconds",
      "response",
      "basis",
      "thresholdSeconds",
      "restSeconds",
      "activeWithinSeconds"
    ],
    "properties": {
      "timeZone": {
        "type": "string",
        "title": "IANA 时区或 system",
        "default": "system",
        "maxLength": 160
      },
      "start": {
        "type": "string",
        "title": "允许时段开始",
        "default": "08:00",
        "maxLength": 160,
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "end": {
        "type": "string",
        "title": "允许时段结束",
        "default": "23:00",
        "maxLength": 160,
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "cooldownSeconds": {
        "type": "integer",
        "title": "此配置冷却（秒）",
        "default": 2700,
        "minimum": 1,
        "maximum": 86400
      },
      "dailyLimit": {
        "type": "integer",
        "title": "此配置每日上限",
        "default": 2,
        "minimum": 1,
        "maximum": 100
      },
      "ttlSeconds": {
        "type": "integer",
        "title": "排队有效期（秒）",
        "default": 180,
        "minimum": 1,
        "maximum": 3600
      },
