{
  "manifest": {
    "format": "ayase.plugin",
    "formatVersion": "1.0",
    "pluginId": "ayase.routine-care",
    "version": "0.3.0",
    "displayName": "作息关怀",
    "apiVersion": "1.0",
    "configVersion": "1.0",
    "runtime": {
      "type": "declarative.v1",
      "entry": "rules/main.json"
    },
    "configSchema": "schemas/config.schema.json",
    "defaultPriority": "background",
    "capabilities": [
      "presentation.request"
    ],
    "hostBehavior": "routine-care",
    "defaults": {
      "timeZone": "system",
      "start": "23:00",
      "end": "07:00",
      "cooldownSeconds": 2700,
      "dailyLimit": 2,
      "ttlSeconds": 180,
      "response": {
        "mode": "generated-with-fallback",
        "intent": "当前处于用户设置的晚间窗口，可以轻声提醒休息，不断言用户失眠或熬夜。",
        "fallback": [
          {
            "id": "default",
            "text": "愿你今天也顺顺利利。"
          }
        ]
      },
      "activeWithinSeconds": 300
    }
  },
  "schema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "timeZone",
      "start",
      "end",
      "cooldownSeconds",
      "dailyLimit",
      "ttlSeconds",
      "response",
      "activeWithinSeconds"
    ],
    "properties": {
      "timeZone": {
        "type": "string",
        "title": "IANA 时区或 system",
        "default": "system",
        "maxLength": 160
      },
      "start": {
        "type": "string",
        "title": "作息窗口开始",
        "default": "23:00",
        "maxLength": 160,
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "end": {
        "type": "string",
        "title": "作息窗口结束",
        "default": "07:00",
        "maxLength": 160,
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      },
      "cooldownSeconds": {
        "type": "integer",
        "title": "此配置冷却（秒）",
        "default": 2700,
        "minimum": 1,
        "maximum": 86400
      },
      "dailyLimit": {
        "type": "integer",
        "title": "此配置每日上限",
        "default": 2,
        "minimum": 1,
        "maximum": 100
      },
      "ttlSeconds": {
        "type": "integer",
        "title": "排队有效期（秒）",
        "default": 180,
        "minimum": 1,
        "maximum": 3600
      },
      "response": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "required": [
          "mode"
        ],
        "additionalProperties": false,
        "properties": {
          "mode": {
            "enum": [
              "fixed",
              "generated",
              "generated-with-fallback"
            ],
            "title": "回复来源：fixed 固定 / generated 生成 / generated-with-fallback 生成并设后备"
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "weight": {
                  "type": "number",
                  "minimum": 0.001,
                  "maximum": 10000
                },
                "text": {
                  "title": "固定文字（支持多段）",
                  "description": "每个列表条目独立分页和阅读；标点与换行保留。整组属于同一任务。",
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "maxLength": 12000
                    },
                    {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string",
                        "maxLength": 12000
                      }
                    }
                  ]
                },
                "textAsset": {
                  "title": "文字素材编号",
                  "description": "按顺序播放，编号可用逗号或换行分隔，也可使用 JSON 数组；最多32条。",
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "maxLength": 8192
                    },
                    {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string",
                        "maxLength": 128
                      }
                    }
                  ]
                },
                "audioAsset": {
                  "title": "音声素材编号",
                  "description": "按顺序播放，编号可用逗号或换行分隔，也可使用 JSON 数组；最多32条。",
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "maxLength": 8192
                    },
                    {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string",
                        "maxLength": 128
                      }
                    }
                  ]
                },
                "cue": {
                  "title": "语义动作编号",
                  "description": "按顺序播放，编号可用逗号或换行分隔，也可使用 JSON 数组；最多32条。",
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "maxLength": 8192
                    },
                    {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string",
                        "maxLength": 128
                      }
                    }
                  ]
                },
                "readMs": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 30000
                }
              }
            },
            "title": "固定回复变体"
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "title": "统一人格生成的互动目的"
          },
          "fallback": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "weight": {
                  "type": "number",
                  "minimum": 0.001,
                  "maximum": 10000
                },
                "text": {
                  "title": "固定文字（支持多段）",
                  "description": "每个列表条目独立分页和阅读；标点与换行保留。整组属于同一任务。",
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "maxLength": 12000
                    },
                    {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string",
                        "maxLength": 12000
                      }
                    }
                  ]
                },
                "textAsset": {
                  "title": "文字素材编号",
                  "description": "按顺序播放，编号可用逗号或换行分隔，也可使用 JSON 数组；最多32条。",
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "maxLength": 8192
                    },
                    {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string",
                        "maxLength": 128
                      }
                    }
                  ]
                },
                "audioAsset": {
                  "title": "音声素材编号",
                  "description": "按顺序播放，编号可用逗号或换行分隔，也可使用 JSON 数组；最多32条。",
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "maxLength": 8192
                    },
                    {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string",
                        "maxLength": 128
                      }
                    }
                  ]
                },
                "cue": {
                  "title": "语义动作编号",
                  "description": "按顺序播放，编号可用逗号或换行分隔，也可使用 JSON 数组；最多32条。",
                  "anyOf": [
                    {
                      "type": "null"
                    },
                    {
                      "type": "string",
                      "maxLength": 8192
                    },
                    {
                      "type": "array",
                      "maxItems": 32,
                      "items": {
                        "type": "string",
                        "maxLength": 128
                      }
                    }
                  ]
                },
                "readMs": {
                  "type": "integer",
                  "minimum": 1000,
                  "maximum": 30000
                }
              }
            },
            "title": "生成失败时明确使用的固定后备"
          },
          "cue": {
            "type": "string",
            "maxLength": 128
          },
          "voice": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mode": {
                "enum": [
                  "off",
                  "tts"
                ]
              },
              "presentationPolicy": {
                "enum": [
                  "text-first",
                  "speech-synchronized"
                ]
              }
            },
            "title": "生成回复的语音策略"
          }
        }
      },
      "activeWithinSeconds": {
        "type": "integer",
        "title": "只在设备最近活跃时提醒（秒）",
        "default": 300,
        "minimum": 1,
        "maximum": 3600
      }
    }
  },
  "rules": {
    "schemaVersion": "1.0",
    "subscriptions": [],
    "rules": []
  }
}
